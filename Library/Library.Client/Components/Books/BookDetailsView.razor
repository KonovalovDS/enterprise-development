@using Library.Client.Models.BookDtos

<div class="card book-details-card mx-auto">
    <BookCover />

    <div class="book-info flex-grow-1">
        <BookField Label="Название" Value="@Book.Title" />
        <BookField Label="Автор" Value="@Book.Author" />
        <BookField Label="Издательство" Value="@Book.Publisher" />
        <BookField Label="Тип публикации" Value="@Book.PublishingType" />
        <BookField Label="Год публикации" Value="@Book.PublicationYear.ToString()" />

        <div class="mt-3 d-flex gap-2 justify-content-end">
            @Actions
        </div>
    </div>
</div>

@code {
    [Parameter] public BookGetDto Book { get; set; } = default!;
    [Parameter] public RenderFragment? Actions { get; set; }
}
