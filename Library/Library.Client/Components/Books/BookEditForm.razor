@using Library.Client.Models.Interfaces
@using Library.Client.Models.BookDtos

@inject IBaseApiService<BookGetDto, BookEditDto> BookService
@inject NavigationManager Navigation

<EditForm Model="bookModel" OnValidSubmit="HandleSave">
    <InputText @bind-Value="bookModel.InventoryNumber" placeholder="Инвентарный номер" />
    <InputText @bind-Value="bookModel.Code" placeholder="Код" />
    <InputText @bind-Value="bookModel.Title" placeholder="Название" />
    <InputText @bind-Value="bookModel.Author" placeholder="Автор" />
    <InputText @bind-Value="bookModel.Publisher" placeholder="Издательство" />
    <InputText @bind-Value="bookModel.PublishingType" placeholder="Тип публикации" />
    <InputNumber @bind-Value="bookModel.PublicationYear" placeholder="Год публикации" />

    <button class="btn-primary" type="submit">Сохранить</button>
</EditForm>

@code {
    [Parameter] 
    public int? BookId { get; set; }

    [Parameter] 
    public EventCallback OnSaved { get; set; }

    private BookEditDto bookModel = new BookEditDto
        {
            InventoryNumber = "0000",
            Code = "XXX",
            Author = "Не указан",
            Title = "Новая книга",
            Publisher = "Не указан",
            PublishingType = "Не указан",
            PublicationYear = DateTime.Now.Year
        };

    protected override async Task OnInitializedAsync()
    {
        if (BookId.HasValue)
        {
            var existing = await BookService.GetAsync(BookId.Value);
            if (existing != null)
            {
                bookModel = new BookEditDto
                    {
                        InventoryNumber = existing.InventoryNumber,
                        Code = existing.Code,
                        Author = existing.Author,
                        Title = existing.Title,
                        Publisher = existing.Publisher,
                        PublishingType = existing.PublishingType,
                        PublicationYear = existing.PublicationYear
                    };
            }
        }
    }

    private async Task HandleSave()
    {
        if (BookId.HasValue)
            await BookService.UpdateAsync(BookId.Value, bookModel);
        else
            await BookService.CreateAsync(bookModel);

        if (OnSaved.HasDelegate)
            await OnSaved.InvokeAsync();
    }
}
