@using Library.Client.Models.BookDtos

<div class="card book-details-card mx-auto" style="max-width: 600px;">
    <BookCover />

    <div class="card-body d-flex flex-column">
        <BookInput Label="Название" @bind-Value="Book.Title" />
        <BookInput Label="Автор" @bind-Value="Book.Author" />
        <BookInput Label="Издательство" @bind-Value="Book.Publisher" />
        <BookInput Label="Тип публикации" @bind-Value="Book.PublishingType" />
        <BookInput Label="Год публикации" Type="number" @bind-Value="Book.PublicationYear" />

        <div class="mt-3 d-flex justify-content-end gap-2">
            @Actions
        </div>
    </div>
</div>

@code {
    [Parameter] public BookEditDto Book { get; set; } = default!;
    [Parameter] public RenderFragment? Actions { get; set; }
}
