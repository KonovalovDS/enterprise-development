@using Library.Client.Models.BookDtos

@using Library.Client.Models.Interfaces
@using Library.Client.Models.BorrowRecordDtos
@inject IBaseApiService<BorrowRecordGetDto, BorrowRecordEditDto> RecordsService

@inject IAuthService AuthService
@inject IBaseApiService<BookGetDto, BookEditDto> BooksService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="book-card" @onclick="GoToDetails">
    <div class="book-image-wrapper">
        <div class="book-image-placeholder"></div>
    </div>

    <h3 class="book-title">@Book.Title</h3>
    <p class="book-author">@Book.Author</p>
    <p class="book-info">@Book.Publisher, @Book.PublicationYear</p>

    <div class="book-card-actions">
        <button class="btn-primary" @onclick="() => ReserveBook(Book.Id)">Забронировать</button>

        <AuthorizeView Roles="Admin">
            <button class="btn-secondary" @onclick:stopPropagation="true" @onclick="EditBook">Редактировать</button>
            <button class="btn-danger" @onclick:stopPropagation="true" @onclick="DeleteBook">Удалить</button>
        </AuthorizeView>
    </div>
</div>

@code {
    [Parameter] public BookGetDto Book { get; set; } = default!;
    [Parameter] public EventCallback<int> OnBookDeleted { get; set; }

    private void ReserveBook(int bookId) =>
        Navigation.NavigateTo($"/records/create/{bookId}");

    private void EditBook() =>
        Navigation.NavigateTo($"/books/edit/{Book.Id}");

    private async Task DeleteBook()
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Удалить книгу '{Book.Title}'?");
        if (confirmed)
        {
            await OnBookDeleted.InvokeAsync(Book.Id);
        }
    }

    private void GoToDetails() =>
        Navigation.NavigateTo($"/books/{Book.Id}");
}