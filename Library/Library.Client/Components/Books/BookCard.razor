@using Library.Client.Models.BookDtos

@using Library.Client.Models.Interfaces
@using Library.Client.Models.BorrowRecordDtos

@inject IBaseApiService<BorrowRecordGetDto, BorrowRecordEditDto> RecordsService
@inject AuthenticationStateProvider AuthState
@inject IAuthService AuthService
@inject IBaseApiService<BookGetDto, BookEditDto> BooksService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="book-card" @onclick="GoToDetails">
    <div class="book-image-wrapper">
        <div class="book-image-placeholder">
            <span>Нет обложки</span>
        </div>
    </div>

    <h3 class="book-title">@Book.Title</h3>
    <p class="book-author">@Book.Author</p>
    <p class="book-info">@Book.Publisher, @Book.PublicationYear</p>

    <div class="book-card-actions" @onclick:stopPropagation="true">
        <button class="btn-primary btn-full" @onclick="() => ReserveBook(Book.Id)">
            Забронировать
        </button>

        <AuthorizeView Roles="Admin">
            <div class="admin-actions">
                <button class="btn-secondary" @onclick="EditBook">
                    Редактировать
                </button>
                <button class="btn-danger" @onclick="DeleteBook">
                    Удалить
                </button>
            </div>
        </AuthorizeView>
    </div>
</div>

@code {
    [Parameter] 
    public BookGetDto Book { get; set; } = default!;

    [Parameter] 
    public EventCallback<int> OnBookDeleted { get; set; }

    private async Task ReserveBook(int bookId)
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var user = authState.User;

        if (!user.Identity?.IsAuthenticated ?? true)
        {
            var returnUrl = Uri.EscapeDataString($"/records/create/{bookId}");
            Navigation.NavigateTo($"/auth/login?returnUrl={returnUrl}");
            return;
        }

        Navigation.NavigateTo($"/records/create/{bookId}");
    }

    private void EditBook() =>
        Navigation.NavigateTo($"/books/edit/{Book.Id}");

    private async Task DeleteBook()
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Удалить книгу '{Book.Title}'?");
        if (confirmed)
        {
            await OnBookDeleted.InvokeAsync(Book.Id);
        }
    }

    private void GoToDetails() =>
        Navigation.NavigateTo($"/books/{Book.Id}");
}