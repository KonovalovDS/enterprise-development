@using Library.Client.Models.BookDtos

<div class="card clickable-card book-card" @onclick="OnOpen">
    <BookCover />

    <div class="card-body d-flex flex-column">
        <h5 class="card-title">@Book.Title</h5>
        <h6 class="card-subtitle mb-2 text-muted">@Book.Author</h6>
        <p class="mb-3">Год: @Book.PublicationYear</p>

        <div class="mt-auto">
            <button class="btn btn-success"
                    @onclick:stopPropagation="true"
                    @onclick="OnBorrow">
                Забронировать
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public BookGetDto Book { get; set; } = default!;
    [Parameter] public EventCallback OnOpen { get; set; }
    [Parameter] public EventCallback OnBorrow { get; set; }
}
