@using Library.Client.Models.BorrowRecordDtos
@using Library.Client.Models.BookDtos
@using Library.Client.Models.CustomerDtos

<div class="card mx-auto p-3 mb-4" style="max-width:700px;">
    <div class="mb-3"><strong>Книга:</strong> @Book.Title</div>
    <div class="mb-3"><strong>Клиент:</strong> @Customer.Name</div>
    <div class="mb-3"><strong>Дата аренды:</strong> @Record.BorrowDate.ToString("yyyy-MM-dd")</div>
    <div class="mb-3"><strong>Срок (дней):</strong> @Record.BorrowDuration</div>
    <div class="mb-3"><strong>Статус:</strong> @(IsActive ? "Активна" : "Завершена")</div>

    <div class="mt-3 d-flex gap-2 justify-content-end">
        <button class="btn btn-primary" @onclick="OnEdit">Редактировать</button>
        <button class="btn btn-danger" @onclick="OnDelete">Удалить</button>
        <button class="btn btn-secondary" @onclick="OnBack">Назад</button>
    </div>
</div>

@code {
    [Parameter] public BorrowRecordGetDto Record { get; set; } = default!;
    [Parameter] public BookGetDto Book { get; set; } = default!;
    [Parameter] public CustomerGetDto Customer { get; set; } = default!;

    [Parameter] public EventCallback OnEdit { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }

    private bool IsActive =>
        Record.BorrowDate.AddDays(Record.BorrowDuration) >=
        DateOnly.FromDateTime(DateTime.Today);
}
