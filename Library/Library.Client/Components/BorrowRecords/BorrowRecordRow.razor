@using Library.Client.Models.BorrowRecordDtos
@using Library.Client.Models.BookDtos
@using Library.Client.Models.CustomerDtos

<tr class="@(IsActive ? "record-active clickable-row" : "clickable-row")"
    @onclick="HandleClick">

    <td>@(Book?.Title ?? "—")</td>
    @if (Customer != null)
    {
        <td>@Customer.Name</td>
    }
    <td>@Record.BorrowDate.ToString("yyyy-MM-dd")</td>
    <td>@Record.BorrowDuration</td>
    <td>@(IsActive ? "Активна" : "Завершена")</td>
</tr>

@code {
    [Parameter] public BorrowRecordGetDto Record { get; set; } = default!;
    [Parameter] public BookGetDto? Book { get; set; }
    [Parameter] public CustomerGetDto? Customer { get; set; }

    [Parameter] public EventCallback<int> OnSelect { get; set; }

    private async Task HandleClick()
    {
        if (OnSelect.HasDelegate)
            await OnSelect.InvokeAsync(Record.Id);
    }

    private bool IsActive =>
        Record.BorrowDate.AddDays(Record.BorrowDuration) >=
        DateOnly.FromDateTime(DateTime.Today);
}
