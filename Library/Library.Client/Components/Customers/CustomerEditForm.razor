@using Library.Client.Models.CustomerDtos
@using Library.Client.Components.Books

<div class="card customer-edit-card mx-auto" style="max-width:600px;">
    <div class="card-body">
        <h5 class="card-title mb-3">Редактирование клиента</h5>

        <div class="mb-3">
            <label class="form-label">Имя</label>
            <input class="form-control" @bind="Customer.Name" />
        </div>

        <div class="mb-3">
            <label class="form-label">Телефон</label>
            <input class="form-control" @bind="Customer.PhoneNumber" />
        </div>

        <div class="mb-3">
            <label class="form-label">Адрес</label>
            <input class="form-control" @bind="Customer.Address" />
        </div>

        <div class="mt-3 d-flex gap-2 justify-content-end">
            @Actions
        </div>
    </div>
</div>

@code {
    [Parameter] public CustomerEditDto Customer { get; set; } = default!;
    [Parameter] public RenderFragment? Actions { get; set; }
}
