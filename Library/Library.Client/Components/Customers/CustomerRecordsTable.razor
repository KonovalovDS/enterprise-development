@using Library.Client.Models.BorrowRecordDtos
@using Library.Client.Models.BookDtos

@if (Records == null || !Records.Any())
{
    <p>Заказов нет.</p>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Книга</th>
                <th>Дата аренды</th>
                <th>Срок (дней)</th>
                <th>Статус</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var record in Records)
            {
                var book = Books.FirstOrDefault(b => b.Id == record.BookId);
                var isActive = record.BorrowDate.AddDays(record.BorrowDuration) >= DateOnly.FromDateTime(DateTime.Today);

                <tr class="@(isActive ? "record-active" : "")">
                    <td>@(book?.Title ?? "—")</td>
                    <td>@record.BorrowDate.ToString("yyyy-MM-dd")</td>
                    <td>@record.BorrowDuration</td>
                    <td>@(isActive ? "Активна" : "Завершена")</td>
                    <td>
                        <button class="btn btn-primary btn-sm me-1"
                                @onclick="() => OnView.InvokeAsync(record.Id)">
                            Подробнее
                        </button>
                        <button class="btn btn-secondary btn-sm"
                                @onclick="() => OnEdit.InvokeAsync(record.Id)">
                            Редактировать
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter] public List<BorrowRecordGetDto> Records { get; set; } = new();
    [Parameter] public List<BookGetDto> Books { get; set; } = new();

    [Parameter] public EventCallback<int> OnView { get; set; }
    [Parameter] public EventCallback<int> OnEdit { get; set; }
}
