@using Library.Client.Models.CustomerDtos

<a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
   @onclick="OnClick">
    <div>
        <strong>@Customer.Name</strong><br />
        <small>@Customer.PhoneNumber | @Customer.Address</small>
    </div>
    <span class="text-muted">@Customer.RegisterDate.ToString("yyyy-MM-dd")</span>
</a>

@code {
    [Parameter] public CustomerGetDto Customer { get; set; } = default!;
    [Parameter] public EventCallback OnClick { get; set; }
}
