@inject NavigationManager Navigation

<AuthorizeView>
    <Authorized Context="auth">
        <div class="d-flex align-items-center gap-2">
            <NavLink class="btn btn-outline-primary d-flex align-items-center" href="/profile">
                <i class="bi bi-person-circle me-1"></i>
                <span>@(string.IsNullOrEmpty(auth.User.Identity?.Name) ? "Профиль" : auth.User.Identity?.Name)</span>
            </NavLink>
            <NavLink class="btn btn-outline-secondary d-flex align-items-center" href="/logout">
                <i class="bi bi-box-arrow-right me-1"></i>
                Выйти
            </NavLink>
        </div>
    </Authorized>
    <NotAuthorized>
        <NavLink class="btn btn-primary d-flex align-items-center" href="/login">
            <i class="bi bi-box-arrow-in-right me-1"></i>
            Войти
        </NavLink>
    </NotAuthorized>
</AuthorizeView>
