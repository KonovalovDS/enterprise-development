@page "/profile/edit"
@attribute [Authorize]

@using Library.Client.Models.CustomerDtos
@using Library.Client.Models.Interfaces
@using Library.Client.Components.Customers
@using Library.Client.Components.Common

@inject IAuthService AuthService
@inject IBaseApiService<CustomerGetDto, CustomerEditDto> CustomerService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<h2 class="mb-4 text-center">Редактирование профиля</h2>

@if (customer == null)
{
    <Loader />
}
else
{
    <CustomerEditForm Customer="customer">
        <Actions>
            <button class="btn btn-primary" @onclick="Save">Сохранить</button>
            <button class="btn btn-secondary" @onclick="GoBack">Отмена</button>
        </Actions>
    </CustomerEditForm>
}

@code {
    private CustomerEditDto? customer;

    protected override async Task OnInitializedAsync()
    {
        var profile = await AuthService.GetMyProfileAsync();

        if (profile == null)
        {
            Navigation.NavigateTo("/");
            return;
        }

        customer = new CustomerEditDto
        {
            Name = profile.Name,
            PhoneNumber = profile.PhoneNumber,
            Address = profile.Address
        };
    }

    private async Task Save()
    {
        if (customer == null)
            return;

        var profile = await AuthService.GetMyProfileAsync();
        if (profile == null)
            return;

        await CustomerService.UpdateAsync(profile.Id, customer);
        Navigation.NavigateTo("/profile");
    }

    private void GoBack() => Navigation.NavigateTo("/profile");
}
