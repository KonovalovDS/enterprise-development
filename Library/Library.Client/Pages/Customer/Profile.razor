@page "/profile"
@attribute [Authorize]

@using Library.Client.Models.CustomerDtos
@using Library.Client.Models.BorrowRecordDtos
@using Library.Client.Models.BookDtos
@using Library.Client.Models.Interfaces
@using Library.Client.Components.Customers
@using Library.Client.Components.Common

@inject AuthenticationStateProvider AuthStateProvider
@inject IBaseApiService<CustomerGetDto, CustomerEditDto> CustomerService
@inject IBaseApiService<BorrowRecordGetDto, BorrowRecordEditDto> RecordService
@inject IBaseApiService<BookGetDto, BookEditDto> BookService
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<h2 class="mb-4 text-center">Мой профиль</h2>

@if (customer == null || records == null || books == null)
{
    <Loader />
}
else
{
    <CustomerDetailsView Customer="customer">
        <Actions>
            <button class="btn btn-primary" @onclick="EditCustomer">Редактировать</button>
            <button class="btn btn-secondary" @onclick="GoBack">Назад</button>
        </Actions>
    </CustomerDetailsView>

    <h3 class="mb-3">История заказов</h3>

    <CustomerRecordsTable Records="records"
                          Books="books"
                          OnView="GoToRecord"
                          OnEdit="EditRecord" />
}

@code {
    private CustomerGetDto? customer;
    private List<BorrowRecordGetDto>? records;
    private List<BookGetDto>? books;

    protected override async Task OnInitializedAsync()
    {
        customer = await AuthService.GetMyProfileAsync();

        if (customer == null)
        {
            Navigation.NavigateTo("/");
            return;
        }

        records = await RecordService.GetAllAsync("api/records/my-records");

        books = await BookService.GetAllAsync();
    }

    private void EditCustomer() =>
        Navigation.NavigateTo($"/profile/edit");

    private void GoBack() =>
        Navigation.NavigateTo("/");

    private void GoToRecord(int id) =>
        Navigation.NavigateTo($"/records/{id}");

    private void EditRecord(int id) =>
        Navigation.NavigateTo($"/records/edit/{id}");
}
