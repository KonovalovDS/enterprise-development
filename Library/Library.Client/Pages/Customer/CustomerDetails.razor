@page "/customers/{Id:int}"
@attribute [Authorize]

@using Library.Client.Models.CustomerDtos
@using Library.Client.Models.BorrowRecordDtos
@using Library.Client.Models.BookDtos
@using Library.Client.Models.Interfaces
@using Library.Client.Components.Customers
@using Library.Client.Components.Common

@inject IBaseApiService<CustomerGetDto, CustomerEditDto> CustomerService
@inject IBaseApiService<BorrowRecordGetDto, BorrowRecordEditDto> RecordService
@inject IBaseApiService<BookGetDto, BookEditDto> BookService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime

<h2 class="mb-4 text-center">Подробности клиента</h2>

@if (customer == null || records == null || books == null)
{
    <Loader />
}
else
{
    <CustomerDetailsView Customer="customer">
        <Actions>
            @if (isAdmin)
            {
                <button class="btn btn-primary" @onclick="() => EditCustomer(customer.Id)">Редактировать</button>
                <button class="btn btn-danger" @onclick="DeleteCustomer">Удалить</button>
            }
            <button class="btn btn-secondary" @onclick="GoBack">Назад</button>
        </Actions>
    </CustomerDetailsView>

    <h3 class="mb-3">История заказов</h3>

    <CustomerRecordsTable Records="records"
                          Books="books"
                          OnView="GoToRecord"
                          OnEdit="EditRecord" />
}

@code {
    [Parameter] public int Id { get; set; }

    private CustomerGetDto? customer;
    private List<BorrowRecordGetDto>? records;
    private List<BookGetDto>? books;
    private bool isAdmin;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isAdmin = user.IsInRole("Admin");

        var data = await CustomerService.GetAsync(Id);

        var userIdClaim = user.FindFirst(c => c.Type == ClaimTypes.NameIdentifier)?.Value;
        int userId = userIdClaim != null ? int.Parse(userIdClaim) : 0;

        if (data == null || (!isAdmin && Id != userId))
        {
            Navigation.NavigateTo("/");
            return;
        }

        customer = data;
        records = (await RecordService.GetAllAsync())
                    .Where(r => r.CustomerId == Id)
                    .ToList();
        books = await BookService.GetAllAsync();
    }

    private void GoBack()
    {
        if (isAdmin) 
            Navigation.NavigateTo("/customers");
        else
            Navigation.NavigateTo("/profile");
    }

    private void EditCustomer(int id) => Navigation.NavigateTo($"/customers/edit/{id}");

    private async Task DeleteCustomer()
    {
        if (customer != null &&
            await JSRuntime.InvokeAsync<bool>("confirm", $"Удалить клиента '{customer.Name}'?"))
        {
            await CustomerService.DeleteAsync(customer.Id);
            Navigation.NavigateTo("/customers");
        }
    }

    private void GoToRecord(int id) => Navigation.NavigateTo($"/records/{id}");
    private void EditRecord(int id) => Navigation.NavigateTo($"/records/edit/{id}");
}