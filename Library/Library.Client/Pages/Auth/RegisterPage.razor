@page "/auth/register"

@using Library.Client.Models.Interfaces
@using Library.Client.Models.AuthDtos
@using Library.Client.Models.CustomerDtos
@using Library.Client.Services
@using Library.Client.Components.Common

@inject IAuthService AuthService
@inject ApiAuthenticationStateProvider AuthState
@inject NavigationManager Navigation

<div class="main-content">
    <div class="content-area auth-page">
        <h2>Регистрация</h2>

        <EditForm Model="registerModel" OnValidSubmit="HandleRegister">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <InputText @bind-Value="registerModel.Email" placeholder="Email" />
            <InputText @bind-Value="registerModel.Password" placeholder="Пароль" type="password" />
            <InputText @bind-Value="registerModel.CustomerDto.Name" placeholder="Имя" />
            <InputText @bind-Value="registerModel.CustomerDto.Address" placeholder="Адрес" />
            <InputText @bind-Value="registerModel.CustomerDto.PhoneNumber" placeholder="Телефон" />

            <button class="btn-primary" type="submit">Зарегистрироваться</button>
        </EditForm>

        @if (!string.IsNullOrEmpty(error))
        {
            <p class="error">@error</p>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(error))
{
    <p class="error">@error</p>
}

@code {
    private RegisterDto registerModel = new RegisterDto
        {
            Email = string.Empty,
            Password = string.Empty,
            CustomerDto = new CustomerEditDto
            {
                Name = string.Empty,
                Address = string.Empty,
                PhoneNumber = string.Empty
            }
        };

    private string? error;

    private async Task HandleRegister()
    {
        var result = await AuthService.RegisterAsync(registerModel);
        if (result != null)
        {
            AuthState.NotifyUserAuthentication();
            Navigation.NavigateTo("/");
        }
        else
        {
            error = "Ошибка регистрации";
        }
    }
}
