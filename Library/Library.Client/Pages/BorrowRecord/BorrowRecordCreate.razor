@page "/records/create"
@attribute [Authorize]

@using Library.Client.Models.BorrowRecordDtos
@using Library.Client.Models.BookDtos
@using Library.Client.Models.CustomerDtos
@using Library.Client.Models.Interfaces
@using Library.Client.Components.BorrowRecords

@inject IBaseApiService<BorrowRecordGetDto, BorrowRecordEditDto> RecordService
@inject IBaseApiService<BookGetDto, BookEditDto> BookService
@inject IBaseApiService<CustomerGetDto, CustomerEditDto> CustomerService
@inject NavigationManager Navigation

<h2 class="mb-4 text-center">Создание записи аренды</h2>

@if (record == null || books == null || customers == null)
{
    <div class="d-flex justify-content-center my-5">
        <div class="spinner-border text-primary"></div>
    </div>
}
else
{
    <BorrowRecordForm
        Model="record"
        Books="books"
        Customers="customers"
        OnSave="Save"
        OnCancel="GoBack" />
}

@code {
    private BorrowRecordEditDto? record;
    private List<BookGetDto>? books;
    private List<CustomerGetDto>? customers;

    protected override async Task OnInitializedAsync()
    {
        record = new BorrowRecordEditDto
        {
            BookId = 0,
            CustomerId = 0,
            BorrowDate = DateOnly.FromDateTime(DateTime.Today),
            BorrowDuration = 7
        };

        books = await BookService.GetAllAsync();
        customers = await CustomerService.GetAllAsync();

        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

        if (int.TryParse(query.Get("bookId"), out var bookId))
        {
            if (books.Any(b => b.Id == bookId))
            {
                record.BookId = bookId;
            }
        }
    }

    private async Task Save()
    {
        if (record != null)
        {
            await RecordService.CreateAsync(record);
            Navigation.NavigateTo("/records");
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/records");
    }
}
