@page "/records"
@using Library.Client.Models.BorrowRecordDtos
@using Library.Client.Models.BookDtos
@using Library.Client.Models.CustomerDtos
@using Library.Client.Models.Interfaces
@inject IBaseApiService<BorrowRecordGetDto, BorrowRecordEditDto> RecordService
@inject IBaseApiService<BookGetDto, BookEditDto> BookService
@inject IBaseApiService<CustomerGetDto, CustomerEditDto> CustomerService
@inject NavigationManager Navigation

<h2 class="mb-4 text-center">Аренды</h2>

@if (records == null || books == null || customers == null)
{
    <div class="d-flex justify-content-center my-5">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else if (!records.Any())
{
    <p class="text-center">Записей нет.</p>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Книга</th>
                <th>Клиент</th>
                <th>Дата аренды</th>
                <th>Срок (дней)</th>
                <th>Статус</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var record in records)
            {
                var book = books.FirstOrDefault(b => b.Id == record.BookId);
                var customer = customers.FirstOrDefault(c => c.Id == record.CustomerId);
                var isActive = record.BorrowDate.AddDays(record.BorrowDuration) >= DateOnly.FromDateTime(DateTime.Today);

                <tr class="@(isActive ? "record-active clickable-row" : "clickable-row")"
                    @onclick="() => NavigateToDetails(record.Id)">
                    <td>@(book?.Title ?? "—")</td>
                    <td>@(customer?.Name ?? "—")</td>
                    <td>@record.BorrowDate.ToString("yyyy-MM-dd")</td>
                    <td>@record.BorrowDuration</td>
                    <td>@(isActive ? "Активна" : "Завершена")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<BorrowRecordGetDto>? records;
    private List<BookGetDto>? books;
    private List<CustomerGetDto>? customers;

    protected override async Task OnInitializedAsync()
    {
        records = await RecordService.GetAllAsync();
        books = await BookService.GetAllAsync();
        customers = await CustomerService.GetAllAsync();
    }

    private void NavigateToDetails(int id) => Navigation.NavigateTo($"/records/{id}");
}
