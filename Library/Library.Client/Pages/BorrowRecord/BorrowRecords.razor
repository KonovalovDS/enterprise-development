@page "/records"
@attribute [Authorize(Roles = "Admin")]

@using Library.Client.Models.BorrowRecordDtos
@using Library.Client.Models.BookDtos
@using Library.Client.Models.CustomerDtos
@using Library.Client.Models.Interfaces
@using Library.Client.Components.BorrowRecords

@inject IBaseApiService<BorrowRecordGetDto, BorrowRecordEditDto> RecordService
@inject IBaseApiService<BookGetDto, BookEditDto> BookService
@inject IBaseApiService<CustomerGetDto, CustomerEditDto> CustomerService
@inject NavigationManager Navigation

<h2 class="mb-4 text-center">Аренды</h2>

@if (records == null)
{
    <div class="spinner-border text-primary"></div>
}
else if (!records.Any())
{
    <p class="text-center">Записей нет.</p>
}
else
{
    <BorrowRecordsTable
        Records="records"
        Books="books!"
        Customers="customers!"
        OnSelect="GoToDetails" />
}

@code {
    private List<BorrowRecordGetDto>? records;
    private List<BookGetDto>? books;
    private List<CustomerGetDto>? customers;

    protected override async Task OnInitializedAsync()
    {
        records = await RecordService.GetAllAsync();
        books = await BookService.GetAllAsync();
        customers = await CustomerService.GetAllAsync();
    }

    private void GoToDetails(int id) =>
        Navigation.NavigateTo($"/records/{id}");
}
