@page "/records/edit/{Id:int}"
@attribute [Authorize]

@using Library.Client.Models.BorrowRecordDtos
@using Library.Client.Models.BookDtos
@using Library.Client.Models.CustomerDtos
@using Library.Client.Models.Interfaces
@using Library.Client.Components.BorrowRecords

@inject IBaseApiService<BorrowRecordGetDto, BorrowRecordEditDto> RecordService
@inject IBaseApiService<BookGetDto, BookEditDto> BookService
@inject IBaseApiService<CustomerGetDto, CustomerEditDto> CustomerService
@inject NavigationManager Navigation

<h2 class="mb-4 text-center">Редактирование записи аренды</h2>

@if (record == null || books == null || customers == null)
{
    <div class="d-flex justify-content-center my-5">
        <div class="spinner-border text-primary"></div>
    </div>
}
else
{
    <BorrowRecordForm
        Model="record"
        Books="books"
        Customers="customers"
        OnSave="Save"
        OnCancel="GoBack" />
}

@code {
    [Parameter]
    public int Id { get; set; }

    private BorrowRecordEditDto? record;
    private List<BookGetDto>? books;
    private List<CustomerGetDto>? customers;

    protected override async Task OnInitializedAsync()
    {
        var data = await RecordService.GetAsync(Id);

        if (data != null)
        {
            record = new BorrowRecordEditDto
            {
                BookId = data.BookId,
                CustomerId = data.CustomerId,
                BorrowDate = data.BorrowDate,
                BorrowDuration = data.BorrowDuration
            };
        }

        books = await BookService.GetAllAsync();
        customers = await CustomerService.GetAllAsync();
    }

    private async Task Save()
    {
        if (record != null)
        {
            await RecordService.UpdateAsync(Id, record);
            Navigation.NavigateTo($"/records/{Id}");
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo($"/records/{Id}");
    }
}
