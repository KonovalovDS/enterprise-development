@page "/records/edit/{Id:int}"
@attribute [Authorize]

@using Library.Client.Models.BorrowRecordDtos
@using Library.Client.Models.BookDtos
@using Library.Client.Models.CustomerDtos
@using Library.Client.Models.Interfaces
@using Library.Client.Components.BorrowRecords

@inject IJSRuntime JS
@inject IBaseApiService<BorrowRecordGetDto, BorrowRecordEditDto> RecordService
@inject IBaseApiService<BookGetDto, BookEditDto> BookService
@inject IBaseApiService<CustomerGetDto, CustomerEditDto> CustomerService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<h2 class="mb-4 text-center">Редактирование записи аренды</h2>

@if (record == null || books == null || (IsAdmin && customers == null))
{
    <div class="d-flex justify-content-center my-5">
        <div class="spinner-border text-primary"></div>
    </div>
}
else
{
    <BorrowRecordForm Model="record"
                      Books="books"
                      Customers="customers"
                      IsAdmin="IsAdmin"
                      CustomerName="CurrentUserName"
                      OnSave="Save"
                      OnCancel="GoBack" />
}

@code {
    [Parameter] public int Id { get; set; }

    private BorrowRecordEditDto? record;
    private List<BookGetDto>? books;
    private List<CustomerGetDto>? customers;

    private bool IsAdmin;
    private string? CurrentUserName;
    private int CurrentUserId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        IsAdmin = user.IsInRole("Admin");
        CurrentUserName = user.Identity?.Name ?? "";
        CurrentUserId = int.TryParse(user.FindFirst("sub")?.Value, out var id) ? id : 0;

        var data = await RecordService.GetAsync(Id);
        if (data == null)
        {
            Navigation.NavigateTo("/records");
            return;
        }

        record = new BorrowRecordEditDto
            {
                BookId = data.BookId,
                CustomerId = data.CustomerId,
                BorrowDate = data.BorrowDate,
                BorrowDuration = data.BorrowDuration
            };

        books = await BookService.GetAllAsync();

        if (IsAdmin)
        {
            customers = await CustomerService.GetAllAsync();
        }
        else
        {
            if (record.CustomerId != CurrentUserId)
            {
                Navigation.NavigateTo("/records");
                return;
            }
        }
    }

    private async Task Save()
    {
        if (record != null)
        {
            await RecordService.UpdateAsync(Id, record);
            Navigation.NavigateTo($"/records/{Id}");
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo($"/records/{Id}");
    }
}
