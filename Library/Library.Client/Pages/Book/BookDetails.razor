@page "/books/{Id:int}"
@using Library.Client.Models.BookDtos
@using Library.Client.Models.Interfaces
@using Library.Client.Components.Common
@using Library.Client.Components.Books
@inject IBaseApiService<BookGetDto, BookEditDto> BookService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<h2 class="mb-4 text-center">Подробности книги</h2>

@if (book == null)
{
    <Loader />
}
else
{
    <BookDetailsView Book="book">
        <Actions>
            <button class="btn btn-primary" @onclick="() => EditBook(book.Id)">Редактировать</button>
            <button class="btn btn-danger" @onclick="DeleteBook">Удалить</button>
            <button class="btn btn-secondary" @onclick="GoBack">Назад</button>
        </Actions>
    </BookDetailsView>
}

@code {
    private BookGetDto? book;

    [Parameter] public int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        book = await BookService.GetAsync(Id);
    }

    private void GoBack() => Navigation.NavigateTo("/books");
    private void EditBook(int id) => Navigation.NavigateTo($"/books/edit/{id}");

    private async Task DeleteBook()
    {
        if (book != null &&
            await JSRuntime.InvokeAsync<bool>("confirm", $"Удалить книгу '{book.Title}'?"))
        {
            await BookService.DeleteAsync(book.Id);
            Navigation.NavigateTo("/books");
        }
    }
}
