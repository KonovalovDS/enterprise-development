@page "/books/{Id:int}"

@using Library.Client.Models.BookDtos
@using Library.Client.Models.Interfaces
@using Library.Client.Components.Common
@using Library.Client.Components.Books

@inject IBaseApiService<BookGetDto, BookEditDto> BookService
@inject NavigationManager Navigation

<div class="main-content">
    @if (book is null)
    {
        <LoadingSpinner />
    }
    else
    {
        <BookDetails Book="book" />
    }
</div>

@code {
    [Parameter] 
    public int Id { get; set; }

    private BookGetDto? book;

    protected override async Task OnInitializedAsync()
    {
        book = await BookService.GetAsync(Id);
    }
}
