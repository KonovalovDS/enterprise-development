@page "/books"

@using Library.Client.Models.BookDtos
@using Library.Client.Models.Interfaces
@using Library.Client.Components.Books
@using Library.Client.Components.Common
@using Microsoft.AspNetCore.Components.Authorization

@inject IBaseApiService<BookGetDto, BookEditDto> BookService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<h2 class="mb-4 text-center">Каталог книг</h2>

@if (books == null)
{
    <Loader />
}
else if (!books.Any())
{
    <p class="text-center">Книг нет.</p>
}
else
{
    <div class="books-grid">
        @foreach (var book in books)
        {
            <BookCard Book="book"
                      OnOpen="() => GoToDetails(book.Id)"
                      OnBorrow="() => BorrowBook(book.Id)" />
        }
    </div>
}

@code {
    private List<BookGetDto>? books;

    protected override async Task OnInitializedAsync()
    {
        books = await BookService.GetAllAsync();
    }

    private void GoToDetails(int id) =>
        Navigation.NavigateTo($"/books/{id}");

    private async Task BorrowBook(int bookId)
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (!user.Identity?.IsAuthenticated ?? true)
        {
            Navigation.NavigateTo($"/login?returnUrl=/records/create?bookId={bookId}");
        }
        else
        {
            Navigation.NavigateTo($"/records/create?bookId={bookId}");
        }
    }
}
